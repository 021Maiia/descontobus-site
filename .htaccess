# Site gerado pelo Descontobus OS. Não edite aqui: as mudanças são feitas pelo sistema.
ErrorDocument 404 /404.html
Options -Indexes
# v1.102 (D-192): /links (antigo link da bio) vai para o início mantendo o ?via= de quem chega; sem ?via=, vale ?via=instagram
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{QUERY_STRING} !(^|&)(via|utm_source)=
  RewriteRule ^links(/(index\.html)?)?$ /?via=instagram [R=301,L,QSA]
  RewriteRule ^links(/(index\.html)?)?$ / [R=301,L]
</IfModule>
# v1.69.0 (D-151): trecho que virou página de rota leva para a rota, para quem chega pelo Google não cair na página de erro
<IfModule mod_alias.c>
  RedirectMatch 301 ^/trechos/rio-de-janeiro/bom-jesus-do-norte-es(/(index\.html)?)?$ /rio-bom-jesus-do-norte/
  RedirectMatch 301 ^/trechos/rio-de-janeiro/vitoria-es(/(index\.html)?)?$ /rio-vitoria/
  RedirectMatch 301 ^/trechos/rio-de-janeiro/belo-horizonte-mg(/(index\.html)?)?$ /rio-belo-horizonte/
  RedirectMatch 301 ^/trechos/rio-de-janeiro/sao-paulo-sp(/(index\.html)?)?$ /rio-sao-paulo/
  RedirectMatch 301 ^/trechos/sao-paulo/salvador-ba(/(index\.html)?)?$ /sao-paulo-salvador/
  RedirectMatch 301 ^/trechos/sao-paulo/brasilia-df(/(index\.html)?)?$ /sao-paulo-brasilia/
  RedirectMatch 301 ^/trechos/sao-paulo/curitiba-pr(/(index\.html)?)?$ /sao-paulo-curitiba/
  RedirectMatch 301 ^/trechos/sao-paulo/rio-de-janeiro-rj(/(index\.html)?)?$ /sao-paulo-rio/
</IfModule>
# v1.31.2: www vai para https://descontobus.com.br, para o Google não ver o site em dobro
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^www\.descontobus\.com\.br$ [NC]
  RewriteRule ^ https://descontobus.com.br%{REQUEST_URI} [R=301,L]
</IfModule>
<IfModule mod_headers.c>
  # v1.67.0 (D-148): X-Frame-Options e frame-ancestors dizem quem pode emoldurar o nosso site e não atrapalham a Buson.
  # Se um dia entrar CSP com regra de molduras, liberar só frame-src https://descontobus.buson.com.br
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  <FilesMatch "\.(webp|png|jpe?g|gif|css|js)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  # v1.34.2: páginas sempre conferidas com o servidor (sem isso o navegador guardava a página velha por horas)
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
